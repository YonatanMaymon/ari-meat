---
import Icon from './ui/Icon.astro';
import { site } from '../data/site';
import { mainNav, quoteLink } from '../data/nav';

const year = new Date().getFullYear();
const socials = [
  { name: 'Instagram', href: site.social.instagram, icon: 'instagram' as const },
].filter((s) => s.href);
---

<footer class="grain bg-charcoal text-cream">
  <div class="container-content grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-2xl font-bold">{site.name}</p>
      <p class="mt-2 text-smoke">{site.tagline}</p>
      <ul class="mt-4 flex gap-3">
        {socials.map((s) => (
          <li>
            <a href={s.href} class="hover:text-ember-light" rel="noopener" target="_blank">
              <Icon name={s.icon} label={`${site.name} ב-${s.name}`} class="size-6" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label="ניווט בתחתית העמוד">
      <h2 class="mb-3 font-sans text-sm font-semibold text-smoke">ניווט</h2>
      <ul class="space-y-2">
        {[...mainNav, quoteLink].map((link) => (
          <li>
            <a href={link.href} class="hover:text-ember-light">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="mb-3 font-sans text-sm font-semibold text-smoke">אזורי שירות</h2>
      <ul class="space-y-2">
        {site.serviceAreas.map((area) => (
          <li>{area.name}</li>
        ))}
      </ul>
    </div>

    <address class="not-italic">
      <h2 class="mb-3 font-sans text-sm font-semibold text-smoke">יצירת קשר</h2>
      <ul class="space-y-2">
        <li>
          <a href={site.phone.href} class="inline-flex items-center gap-2 hover:text-ember-light">
            <Icon name="phone" />
            <span dir="ltr">{site.phone.display}</span>
          </a>
        </li>
        <li>
          <a
            href={site.whatsapp.href}
            class="inline-flex items-center gap-2 hover:text-ember-light"
          >
            <Icon name="whatsapp" />
            וואטסאפ
          </a>
        </li>
        <li>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 hover:text-ember-light"
          >
            <Icon name="mail" />
            <span dir="ltr">{site.email}</span>
          </a>
        </li>
        <li>
          {site.address.street}, {site.address.locality}, {site.address.region}
        </li>
      </ul>
    </address>
  </div>
  <div class="border-t border-cream/10">
    <p class="container-content py-5 text-sm text-smoke">
      © {year} {site.name}. כל הזכויות שמורות.
    </p>
  </div>
</footer>
