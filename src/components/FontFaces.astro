---
// Loads the two fonts chosen in the admin (src/content/settings.yaml) and points Tailwind's
// --font-sans / --font-display at them. Only their Hebrew files are preloaded; Latin loads on use.
import { getEntry } from 'astro:content';
import { fonts } from '../data/fonts';
import { defaultFonts } from '../data/font-options';

const settings = (await getEntry('settings', 'settings'))?.data;
const heading = fonts[settings?.headingFont ?? defaultFonts.heading];
const body = fonts[settings?.bodyFont ?? defaultFonts.body];

const hebrew = 'U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F';
const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

// A single-weight font claims every weight, so bold headings use it as is instead of faking bold.
const faces = [...new Set([heading, body])].flatMap((font) =>
  [
    [font.hebrew, hebrew],
    [font.latin, latin],
  ].map(
    ([url, range]) =>
      `@font-face{font-family:'${font.family}';font-style:normal;font-display:swap;font-weight:${font.variable ? '100 900' : '1 1000'};src:url(${url}) format('woff2');unicode-range:${range}}`,
  ),
);
const stack = (font: typeof heading) =>
  `'${font.family}', ${font.serif ? "'Times New Roman', serif" : "'Arial Hebrew', Arial, sans-serif"}`;
const css = `${faces.join('')}:root{--font-sans:${stack(body)};--font-display:${stack(heading)}}`;
---

{[...new Set([heading.hebrew, body.hebrew])].map((href) => (
  <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
))}
<style is:inline set:html={css} />
