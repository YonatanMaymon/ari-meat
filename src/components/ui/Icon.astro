};

/** Icons that point along the reading direction and must mirror in RTL. */
const directional = new Set<keyof typeof icons>(['arrow']);

export type IconName = keyof typeof icons;

export interface Props {
  name: IconName;
  /** Accessible label. Omit for decorative icons next to visible text. */
  label?: string;
  class?: string;
}

const { name, label, class: className = 'size-5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  class:list={[className, 'shrink-0', directional.has(name) && 'rtl:-scale-x-100']}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={icons[name]}></path>
</svg>
