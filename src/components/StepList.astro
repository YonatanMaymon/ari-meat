---
// Numbered "how it works" steps. Uses <ol> so screen readers announce the order.
export interface Props {
  steps: readonly { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {steps.map((step, i) => (
    <li class="relative ps-14">
      <span
        aria-hidden="true"
        class="absolute start-0 top-0 flex size-10 items-center justify-center rounded-full bg-brass-deep font-display text-lg font-bold text-white"
      >
        {i + 1}
      </span>
      <h3 class="text-xl font-bold">{step.title}</h3>
      <p class="mt-2 text-muted">{step.text}</p>
    </li>
  ))}
</ol>
