---
import Icon from './ui/Icon.astro';
import type { Crumb } from '../lib/schema';

export interface Props {
  /** From the homepage to the current page; the last crumb is the current page. */
  crumbs: readonly Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="פירורי לחם" class="mb-6 text-sm">
  <ol class="flex flex-wrap items-center gap-2 text-cream/80">
    {crumbs.map((crumb, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <Icon name="chevron" class="size-4 rotate-90 ltr:-rotate-90" />}
        {crumb.href && i < crumbs.length - 1 ? (
          <a href={crumb.href} class="underline-offset-4 hover:text-ember-light hover:underline">
            {crumb.label}
          </a>
        ) : (
          <span aria-current="page" class="text-cream">
            {crumb.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
