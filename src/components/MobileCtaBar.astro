---
import Icon from './ui/Icon.astro';
import { site } from '../data/site';
import { quoteLink } from '../data/nav';
---

<!-- Fixed to the bottom on phones only. BaseLayout pads the page so it never hides the footer. -->
<nav
  aria-label="יצירת קשר מהירה"
  class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-3 border-t border-cream/10 bg-charcoal pb-[env(safe-area-inset-bottom)] text-sm font-semibold text-cream md:hidden"
>
  <a href={site.whatsapp.href} class="flex flex-col items-center gap-1 py-2.5">
    <Icon name="whatsapp" class="size-6 text-[#25d366]" />
    וואטסאפ
  </a>
  <a href={site.phone.href} class="flex flex-col items-center gap-1 py-2.5">
    <Icon name="phone" class="size-6" />
    התקשרו
  </a>
  <a
    href={quoteLink.href}
    class="flex flex-col items-center justify-center gap-1 bg-brass-deep py-2.5 text-white"
  >
    <Icon name="mail" class="size-6" />
    הצעת מחיר
  </a>
</nav>
