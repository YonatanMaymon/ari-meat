---
import { Image } from 'astro:assets';
import logo from '../assets/images/brand/logo-dark.png';
import logoCream from '../assets/images/brand/logo-cream.png';
import Icon from './ui/Icon.astro';
import SocialButtons from './SocialButtons.astro';
import Button from './ui/Button.astro';
import { site } from '../data/site';
import { mainNav, quoteLink } from '../data/nav';
import { isActive, publicPath } from '../lib/url';

const current = publicPath(Astro.url);
---

<header class="sticky top-0 z-40 border-b border-charcoal/10 bg-cream text-charcoal">
  <!-- Three columns: nav (or the menu button) | centred logo | social links and phone. -->
  <div class="container-content grid h-19 grid-cols-[1fr_auto_1fr] items-center gap-4 lg:h-26">
    <div class="flex items-center">
      <!-- Popover API: open/close, Escape and light dismiss with no JavaScript. -->
      <button
        type="button"
        popovertarget="mobile-menu"
        class="-ms-2 p-2 lg:hidden"
        aria-label="פתיחת תפריט"
      >
        <Icon name="menu" class="size-7" />
      </button>

      <nav aria-label="ניווט ראשי" class="hidden lg:block">
        <ul class="flex items-center gap-5 xl:gap-6">
          {mainNav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current === link.href ? 'page' : undefined}
                class:list={[
                  'py-2 whitespace-nowrap transition-colors hover:text-brass-deep',
                  isActive(link.href, current) && 'text-brass-deep',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <a href="/" class="block" aria-current={current === '/' ? 'page' : undefined}>
      <Image
        src={logo}
        alt={`${site.name} - ${site.tagline}`}
        widths={[120, 180, 240]}
        sizes="(min-width: 64rem) 84px, 60px"
        class="h-15 w-auto lg:h-21"
        loading="eager"
      />
    </a>

    <div class="flex items-center justify-end gap-2">
      <SocialButtons size="md" class="max-sm:hidden" whatsapp />
      <SocialButtons size="sm" class="sm:hidden" />
      <a
        href={site.phone.href}
        class="ms-1.5 hidden items-center gap-2 rounded-full border-[1.5px] border-charcoal px-4.5 py-2 font-semibold transition-colors hover:bg-charcoal hover:text-cream xl:inline-flex"
      >
        <Icon name="phone-outline" class="size-[1.125rem]" />
        <span dir="ltr">{site.phone.display}</span>
      </a>
    </div>
  </div>

  <div
    id="mobile-menu"
    popover
    class="m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto bg-charcoal p-0 text-cream backdrop:bg-black/50 lg:hidden"
  >
    <div class="container-content flex h-19 items-center justify-between">
      <Image
        src={logoCream}
        alt={`${site.name} - ${site.tagline}`}
        widths={[120]}
        class="h-12 w-auto"
      />
      <button
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        class="-me-2 p-2"
        aria-label="סגירת תפריט"
      >
        <Icon name="close" class="size-7" />
      </button>
    </div>
    <nav aria-label="ניווט ראשי" class="container-content pb-32">
      <ul class="divide-y divide-cream/10 text-xl">
        {mainNav.map((link) => (
          <li class="py-3">
            <a
              href={link.href}
              aria-current={current === link.href ? 'page' : undefined}
              class:list={[
                'block py-1 font-semibold',
                isActive(link.href, current) && 'text-brass-light',
              ]}
            >
              {link.label}
            </a>
            {link.children && (
              <ul class="mt-1 space-y-1 ps-4 text-base">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={current === child.href ? 'page' : undefined}
                      class:list={[
                        'block py-1.5',
                        current === child.href ? 'text-brass-light' : 'text-smoke',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <Button href={quoteLink.href} size="lg" class="mt-8 w-full">
        {quoteLink.label}
      </Button>
      <SocialButtons tone="dark" size="lg" whatsapp class="mt-6 justify-center" />
    </nav>
  </div>
</header>
