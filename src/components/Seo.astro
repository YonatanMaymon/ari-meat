---
import { site } from '../data/site';
import { formatTitle } from '../lib/seo';
import { publicPath } from '../lib/url';

export interface Props {
  /** Keyword-focused page title, without the brand. Omit on the homepage. */
  title?: string;
  /** Unique meta description, ideally under 155 characters. */
  description: string;
  /** Absolute or root-relative share image for WhatsApp/Facebook previews (1200×630). */
  image?: string;
  /** Hebrew description of the share image. */
  imageAlt?: string;
  noindex?: boolean;
  /** Structured data for this page (one schema.org object or several). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, imageAlt, noindex = false, jsonLd } = Astro.props;

const fullTitle = formatTitle(title);
const canonical = new URL(publicPath(Astro.url), Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
// Escape "<" so a string inside the data can never close the <script> tag.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;

if (import.meta.env.DEV && description.length > 155) {
  console.warn(`[seo] description is ${description.length} chars (max 155): ${canonical}`);
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

{jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
