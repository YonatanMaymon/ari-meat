---
import Icon from './ui/Icon.astro';

export interface Props {
  quote: string;
  name: string;
  /** e.g. "חתונה בטבע, עמק יזרעאל" */
  event?: string;
}

const { quote, name, event } = Astro.props;
---

<figure class="flex h-full flex-col gap-4 rounded-card bg-charcoal-soft p-7 text-cream">
  <Icon name="quote" class="size-9 text-ember" />
  <blockquote class="flex-1 text-lg leading-relaxed">
    <p>{quote}</p>
  </blockquote>
  <figcaption>
    <span class="font-semibold">{name}</span>
    {event && <span class="block text-sm text-cream/75">{event}</span>}
  </figcaption>
</figure>
