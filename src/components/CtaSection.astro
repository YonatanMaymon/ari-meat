---
// The closing call to action at the bottom of every page: option B "split" from the design canvas
// (yonatan, 2026-10-24). Text, big phone number and buttons on one side, a photo on the other;
// on phones the photo sits on top.
import { Image } from 'astro:assets';
import photo from '../assets/images/heroes/slicing-roast-beef.jpg';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import SocialButtons from './SocialButtons.astro';
import { site } from '../data/site';
import { quoteLink } from '../data/nav';

export interface Props {
  heading?: string;
  text?: string;
  /** Defaults to the contact page. Service pages add `?service=` to preselect the event type. */
  quoteHref?: string;
}

const {
  quoteHref = quoteLink.href,
  heading = 'בואו נדליק את האש',
  text = 'ספרו לנו על האירוע: מה חוגגים, כמה אורחים ואיפה. נחזור אליכם עם רעיונות לתפריט והצעת מחיר.',
} = Astro.props;
---

<section aria-labelledby="cta-heading" class="grid bg-charcoal text-cream md:grid-cols-2">
  <div class="flex flex-col justify-center gap-5 px-4 pt-10 pb-14 sm:px-6 md:px-12 md:py-20 lg:px-16">
    <h2 id="cta-heading" class="text-4xl font-bold lg:text-5xl">
      {heading}
    </h2>
    <p class="text-lg leading-relaxed text-cream/90">{text}</p>
    <a
      href={site.phone.href}
      dir="ltr"
      class="self-start font-display text-4xl font-bold text-brass-light hover:text-cream lg:text-[2.75rem]"
    >
      {site.phone.display}
    </a>
    <div class="flex items-center gap-3">
      <Button href={quoteHref} size="lg" class="max-sm:flex-1">
        {quoteLink.label}
      </Button>
      <a
        href={site.whatsapp.href}
        target="_blank"
        rel="noopener"
        class="inline-flex size-13.5 shrink-0 items-center justify-center rounded-full bg-whatsapp text-white transition hover:brightness-110"
      >
        <Icon name="whatsapp" label="וואטסאפ" class="size-7" />
      </a>
    </div>
    <SocialButtons tone="dark" size="lg" class="mt-1" />
  </div>
  <Image
    src={photo}
    alt="פריסת רוסטביף על קרש עץ"
    widths={[480, 800, 1280]}
    sizes="(min-width: 48rem) 50vw, 100vw"
    class="-order-1 h-65 w-full object-cover md:order-none md:h-full md:min-h-145"
  />
</section>
