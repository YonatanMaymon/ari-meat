---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './ui/Icon.astro';

export interface Props {
  title: string;
  description: string;
  href: string;
  image?: ImageMetadata;
  /** Hebrew alt text. Required with `image`. */
  imageAlt?: string;
  /** Heading level inside the page outline (h3 under a section h2 by default). */
  headingLevel?: 'h2' | 'h3';
}

const {
  title,
  description,
  href,
  image,
  imageAlt = '',
  headingLevel: Heading = 'h3',
} = Astro.props;
---

<article class="group relative flex flex-col overflow-hidden rounded-card bg-white shadow-sm ring-1 ring-charcoal/5 transition-shadow hover:shadow-lg">
  {image ? (
    <Image
      src={image}
      alt={imageAlt}
      width={800}
      height={600}
      fit="cover"
      widths={[400, 800]}
      quality={70}
      sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
      class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  ) : (
    <div aria-hidden="true" class="grain aspect-[4/3] bg-charcoal" />
  )}
  <div class="flex flex-1 flex-col gap-3 p-6">
    <Heading class="text-2xl font-bold">
      <!-- The ::after stretches the link over the whole card, keeping one link per card. -->
      <a href={href} class="after:absolute after:inset-0">
        {title}
      </a>
    </Heading>
    <p class="flex-1 text-smoke-deep">{description}</p>
    <span aria-hidden="true" class="inline-flex items-center gap-1 font-semibold text-ember-deep">
      לפרטים
      <Icon name="arrow" class="size-4 transition-transform group-hover:-translate-x-1" />
    </span>
  </div>
</article>
