---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';
---

<BaseLayout description="קייטרינג בשרי על האש המשלב מטבח ארגנטינאי וגלילי. חתונות בטבע, אירועים פרטיים ועסקיים בכל הארץ.">
  <!-- Placeholder until the real homepage is built in Phase 3. -->
  <Hero title={site.name} subtitle={`${site.tagline}. האתר החדש בבנייה.`} size="full">
    <Button href={site.whatsapp.href} variant="whatsapp" size="lg" icon="whatsapp">
      וואטסאפ
    </Button>
    <Button href={site.phone.href} variant="secondary-dark" size="lg" icon="phone">
      <span dir="ltr">{site.phone.display}</span>
    </Button>
  </Hero>
</BaseLayout>
