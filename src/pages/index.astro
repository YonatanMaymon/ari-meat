---
// Homepage: hero → Ari → services → how it works → expertise → service areas → CTA.
// All of the text is Ari's own, word for word from the old Wix homepage
// (content-migration/pages/home.md), and edited by him in the admin (src/content/pages/home.yaml).
// Longer parts fold behind ReadMore toggles. The hero is direction A, "fire at night" (Phase 2).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Markdown from '../components/Markdown.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StepList from '../components/StepList.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import CtaSection from '../components/CtaSection.astro';
import ReadMore from '../components/ReadMore.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';
import { quoteLink } from '../data/nav';
import { getPage } from '../lib/pages';
import { getServices, serviceHref } from '../lib/services';
import { business, website } from '../lib/schema';

const page = await getPage('homePage');
const { about, expertise, areas } = page;
const services = await getServices();

const prose = 'max-w-3xl text-lg leading-relaxed';
---

<BaseLayout
  description="קייטרינג בשרי על האש, מטבח ארגנטינאי וגלילי. חתונות בטבע, אירועים פרטיים ועסקיים בצפון ובכל הארץ, וחוויות במטעים שלנו במתת. קבלו הצעת מחיר."
  image={page.heroImage}
  imageAlt={page.heroAlt}
  jsonLd={[await business(), website()]}
>
  <Hero
    image={page.heroImage}
    imageAlt={page.heroAlt}
    title={page.heroTitle}
    eyebrow={page.heroEyebrow || undefined}
    subtitle={page.heroSubtitle}
    size="full"
  >
    <Button href={quoteLink.href} size="lg">
      {quoteLink.label}
    </Button>
    <Button href={site.whatsapp.href} variant="whatsapp" size="lg" icon="whatsapp">
      וואטסאפ
    </Button>
  </Hero>

  <Section heading={about.heading} eyebrow={about.eyebrow || undefined}>
    <div class:list={[prose, 'space-y-5']}>
      <Markdown text={about.text} />
      {about.moreText && (
        <ReadMore>
          {about.moreHeading && <h3 class="pt-2 text-2xl font-bold">{about.moreHeading}</h3>}
          <Markdown text={about.moreText} />
        </ReadMore>
      )}
    </div>
  </Section>

  <Section tone="sand" heading={page.services.heading} intro={page.services.intro || undefined}>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ServiceCard
          title={s.data.label}
          description={s.data.summary}
          href={serviceHref(s)}
          image={s.data.image}
          imageAlt={s.data.imageAlt}
        />
      ))}
    </div>
    {page.services.more.length > 0 && (
      <div class="mt-12 max-w-3xl">
        <div class="divide-y divide-charcoal/10 border-y border-charcoal/10">
          {page.services.more.map((row) => (
            <ReadMore variant="row" label={row.label}>
              <Markdown text={row.text} />
            </ReadMore>
          ))}
        </div>
      </div>
    )}
  </Section>

  <Section heading={page.steps.heading} eyebrow={page.steps.eyebrow || undefined}>
    <StepList steps={page.steps.items} />
  </Section>

  <Section tone="dark" heading={expertise.heading} eyebrow={expertise.eyebrow || undefined}>
    <div class:list={[prose, 'space-y-5']}>
      <Markdown text={expertise.text} dark />
      {expertise.moreText && (
        <ReadMore dark>
          <Markdown text={expertise.moreText} dark />
        </ReadMore>
      )}
    </div>
    <p class="mt-8">
      <a href="/menu" class="font-semibold text-ember-light underline underline-offset-4">
        לתפריט
      </a>
    </p>
  </Section>

  <Section tone="sand" heading={areas.heading} eyebrow={areas.eyebrow || undefined}>
    <Markdown text={areas.text} class={prose} />
    <div class="mt-10">
      <ServiceAreas />
    </div>
    <div class:list={[prose, 'mt-10 space-y-5']}>
      {areas.closing && <Markdown text={areas.closing} />}
      <p class="text-2xl font-bold">
        <a href={site.phone.href} class="hover:text-ember-deep" dir="ltr">
          {site.phone.display}
        </a>
        <br />
        <a href={`mailto:${site.email}`} class="hover:text-ember-deep" dir="ltr">
          {site.email}
        </a>
      </p>
    </div>
  </Section>

  <CtaSection />
</BaseLayout>
