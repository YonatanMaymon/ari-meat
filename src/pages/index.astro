---
// Homepage: hero → Ari → services → how it works → expertise → service areas → CTA.
// All of the text is Ari's own, word for word from the old Wix homepage
// (content-migration/pages/home.md). Longer parts fold behind ReadMore toggles.
// The hero is direction A, "fire at night" (Phase 2).
import heroImage from '../assets/images/heroes/asado-cross-fire.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StepList from '../components/StepList.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import CtaSection from '../components/CtaSection.astro';
import ReadMore from '../components/ReadMore.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';
import { quoteLink } from '../data/nav';
import { getServices, serviceHref } from '../lib/services';
import { business, website } from '../lib/schema';

const services = await getServices();

const steps = [
  { title: 'מדברים', text: 'מספרים לנו מה חוגגים, כמה אורחים ואיפה.' },
  { title: 'בונים תפריט', text: 'תפריט שנבנה בשבילכם, עם הצעת מחיר מסודרת.' },
  { title: 'מדליקים את האש', text: 'מגיעים לפחות 5 שעות לפני ומקימים מטבח שלם.' },
  { title: 'אתם אורחים', text: 'אנחנו מבשלים, מגישים ומפנים. אתם נהנים.' },
];

const link = 'font-semibold text-ember-deep underline underline-offset-4';
const prose = 'max-w-3xl space-y-5 text-lg leading-relaxed';
---

<BaseLayout
  description="קייטרינג בשרי על האש, מטבח ארגנטינאי וגלילי. חתונות בטבע, אירועים פרטיים ועסקיים בצפון ובכל הארץ, וחוויות במטעים שלנו במתת. קבלו הצעת מחיר."
  image={heroImage}
  imageAlt="שף מסדר נתחי אסאדו על צלב מעל אש חיה"
  jsonLd={[await business(), website()]}
>
  <Hero
    image={heroImage}
    imageAlt="שף מסדר נתחי אסאדו על צלב מעל אש חיה"
    title="ארי קייטרינג - חווית בשרים ייחודית"
    eyebrow="מתת, הגליל העליון"
    subtitle="שילוב של מטבח ארגנטינאי ומטבח ים-תיכוני גלילי שמגיע לכל מקום שתבחרו"
    size="full"
  >
    <Button href={quoteLink.href} size="lg">
      {quoteLink.label}
    </Button>
    <Button href={site.whatsapp.href} variant="whatsapp" size="lg" icon="whatsapp">
      וואטסאפ
    </Button>
  </Hero>

  <Section heading="נעים להכיר !" eyebrow="הסיפור">
    <div class={prose}>
      <p>
        שמי ארי והסיפור שלי עם בשר, אוכל, אדמה ואש חיה התחיל מגיל קטן, מהבית, תמיד נמשכתי לקשר
        הראשוני הזה שבין אש חיה לנתחי בשר ולקשר שבין האדמה ולירקות ולפירות שאנו אוכלים. אני גר במתת,
        ישוב קטן ממש על גבול לבנון שנמצא בגליל המערבי. יש לנו גינת ירק גדולה ועשירה ומטעים של זיתים,
        גפנים, תאנים ודובדבנים. כל החקלאות שלנו נעשית בצורה אורגנית ומסורתית. לקריאה מורחבת על
        אירועים פרטיים, סדנאות וארוחות אצלי בבית במתת{' '}
        <a href="/matat/private-chef" class={link}>
          לחצו כאן
        </a>
      </p>
      <ReadMore>
        <h3 class="pt-2 text-2xl font-bold">האש האדמה והסיפור שלי</h3>
        <p>
          היום, כשיש לי חברת קייטרינג משלי, אני מביא את כל התשוקה הזו לכל אירוע שאני מפיק. כשאני
          ניגש לתכנן חווית בשרים לחתונה בטבע, ארוחת שף פרטית או עמדת בשרים לאירוע שטח המטרה העיקרית
          שלי היא לייצר רגע שבו הזמן עוצר מלכת והאורחים שלכם נהנים מהבשר, הירקות והדגים הכי איכותיים
          שהם טעמו. מעבר לכך, אני מקפיד על השירות הכי אדיב שאפשר להציע, חיוך רחב שלי ושל הצוות שלי
          ותנאי היגיינה ונקיון ברמה הכי גבוהה.
        </p>
        <p>
          בתור שף בשרים שחי ונושם את עולם הצלייה והעישון, אני לא מאמין בקיצורי דרך. בין אם מדובר ב
          <a href="/catering/private-events" class={link}>
            קייטרינג לאירועים קטנים
          </a>
          ,{' '}
          <a href="/catering/weddings" class={link}>
            קייטרינג לחתונות שטח
          </a>
          , חגיגות בר/בת מצווה או ברית, קייטרינג כשר ל
          <a href="/catering/corporate-events" class={link}>
            אירועי חברה ואירועים עסקיים
          </a>{' '}
          או כל אירוע בשרים איכותי אחר אני מתחיל בבחירה קפדנית של חומרי הגלם. אני בוחר באופן אישי את
          הנתחים ומוודא את הרמה שלהם, הטריות, השיוש, הישון ומלווה את התהליך מההתחלה ועד לרגע שבו
          הבשר נפרס מול האורחים שלכם. מעבר לכך כל הירקות והפירות שאני מביא מגיעים ממקומות איכותיים,
          ממשקים פרטיים בגליל המערבי, שם אני חי.
        </p>
      </ReadMore>
    </div>
  </Section>

  <Section
    tone="sand"
    heading="מה אנחנו עושים"
    intro="חווית הבשרים שלי מגיעה לכל איזור בארץ, עם כל הציוד הלוגיסטי, הנתחים והירקות."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ServiceCard
          title={s.data.label}
          description={s.data.summary}
          href={serviceHref(s)}
          image={s.data.image}
          imageAlt={s.data.imageAlt}
        />
      ))}
    </div>
    <div class="mt-12 max-w-3xl">
      <div class="divide-y divide-charcoal/10 border-y border-charcoal/10">
        <ReadMore variant="row" label="מטבח שף בלב הטבע: קייטרינג לחתונות ואירועים בטבע">
          <p>
            כאן נכנס היתרון האמיתי של ארי קייטרינג. אני מומחה בביצוע הפקת אירועים בטבע. מבחינתי,
            השטח הוא המגרש הביתי. אני יודע לקחת את כל הציוד הלוגיסטי המורכב ביותר ולבצע ארגון
            אירועים בשטח ברמה של מסעדת שף בלב היער, במדבר או מול הים.
            <br />
            מתן פתרונות של קייטרינג לאירועי שטח או קייטרינג לאירועי חוץ דורש לוגיסטיקה חכמה. אני
            מביא איתי את הציוד, הצוות והניסיון שמאפשרים לנו להקים אירועי בשר כשרים בשטח פתוח ללא
            תלות בתשתיות קיימות.
          </p>
          <p>
            כשאני מציע קייטרינג לאירועים בטבע, אני מבטיח לכם שכל אורח ירגיש כאילו הוא יושב במסעדה
            הכי טובה בעיר, בזמן שהנוף סביבו הוא הטבע הפראי. אם אתם מחפשים קייטרינג לחתונה בטבע או
            לכל סוג אחר של אירוע בשטח, אני כאן כדי להפוך את הלוגיסטיקה המורכבת לחוויה קולינרית חלקה
            ומרשימה. לקריאה מורחבת על קייטרינג לחתונה בטבע{' '}
            <a href="/catering/weddings" class={link}>
              לחצו כאן
            </a>{' '}
            רוצים לקבל הצעת מחיר ופרטים נוספים ? תצלצלו אלי, שלחו ווצאפ או תשאירו{' '}
            <a href={quoteLink.href} class={link}>
              כאן
            </a>{' '}
            פרטים ואחזור אליכם בהקדם.
          </p>
        </ReadMore>
        <ReadMore variant="row" label="קייטרינג לאירועי חברה ואירועים עסקיים: סטנדרט של פרימיום">
          <p>
            בעולם העסקי, אירוע הוא כלי לבניית קשרים וליצירת זיכרונות. אני מספק קייטרינג כשר לאירועים
            עסקיים שמחפשים לשדר סטנדרט גבוה, אלגנטי, אותנטי וחכם וגם קייטרינג לאירועי חברה שמחפשים
            משהו שונה מהבנאלי, משהו קרוב יותר לטבע שמשלב אוכל טעים ואיכותי עם אש חיה. בנוסף אני בונה
            גם תוכניות לימי גיבוש בצפון לקבוצות קטנות אצלי במטעים הפסטורלים ובבית שלי במתת.
          </p>
          <p>
            אני אדע לתפור למידותכם את סגנון האירוע המושלם בכל מקום שתבחרו. בין אם אתם מחפשים
            קייטרינג להרמת כוסית, למפגש עסקי או ליום גיבוש של החברה אני אבנה לכם את התפריט המתאים
            ביותר עבורכם. לקריאה מורחבת על קייטרינג לאירועי חברה ואירועים עסקיים{' '}
            <a href="/catering/corporate-events" class={link}>
              לחצו כאן
            </a>
            . רוצים לקבל הצעת מחיר ופרטים נוספים ? תצלצלו אלי, שלחו ווצאפ או תשאירו{' '}
            <a href={quoteLink.href} class={link}>
              כאן
            </a>{' '}
            פרטים ואחזור אליכם בהקדם.
          </p>
        </ReadMore>
        <ReadMore variant="row" label="חוויה גלילית במטעים שלנו: ימי גיבוש שעוצרים את הזמן">
          <p>
            מעבר לשירותי הקייטרינג, אני מזמין אתכם אלי הביתה – לאירוח במטעים אורגניים של משפחתנו
            במושב מתת. כאן, על מרפסת מול נוף פנורמי שנמתח מהרי הגליל המערבי ועד לים התיכון, אני
            מארגן מגוון רחב של פעילויות המשלבות שקט גלילי, אוויר הרים צלול וחיבור אמיתי לאדמה:
          </p>
          <ul class="list-disc space-y-2 ps-6">
            <li>
              <strong>ימי גיבוש למנהלים וצוותי הייטק:</strong> הזדמנות להתנתק מהרעש היומיומי לטובת
              ריטריט מנהלים בצפון או Offsite קולינרי למנהלים המשלב עבודה וחברה.
            </li>
            <li>
              <strong>אירועי בוטיק לקבוצות קטנות:</strong> אירוח פרטי הכולל ארוחות שף מהטאבון הלוהט,
              בשרים מעושנים ויין משובח מהיקב הפרטי שלנו.
            </li>
            <li>
              <strong>סדנאות תוכן וחוויה:</strong> סדנת בשרים ויין למנהלים, סדנאות מנהיגות בטבע
              וסדנאות חקלאות וקיימות.
            </li>
            <li>
              <strong>סיורים וחקלאות מסורתית:</strong> סיור מודרך במטעים האורגניים ובגינת הירק, כולל
              טעימות של שמן זית, גבינות ותוצרת מקומית שאנחנו מייצרים.
            </li>
          </ul>
          <p>
            זהו לא עוד יום כיף סטנדרטי, אלא יום גיבוש אקסקלוסיבי המהווה מסע קולינרי וחקלאי באווירה
            פרטית ויוצאת דופן. אני מאמין כשמשלבים בשר משובח, יין טוב וסיפור חקלאי אותנטי מול נוף
            עוצר נשימה, נוצר חיבור אנושי ששום חדר ישיבות לא יכול לייצר.
            <br />
            לקריאה מורחבת על ימי גיבוש למנהלים או צוותי פיתוח במתת{' '}
            <a href="/matat/team-building" class={link}>
              לחצו כאן
            </a>{' '}
            ולאירוח קבוצות קטנות במטעים{' '}
            <a href="/matat/private-chef" class={link}>
              לחצו כאן
            </a>{' '}
            רוצים לקחת את הצוות שלכם ליום גיבוש במטעים במתת שלא שוכחים? תצלצלו אלי, שלחו ווצאפ או
            תשאירו{' '}
            <a href={quoteLink.href} class={link}>
              כאן
            </a>{' '}
            פרטים ואחזור אליכם בהקדם.
          </p>
        </ReadMore>
        <ReadMore variant="row" label="בוטיק בבית: קייטרינג בשרי לאירועים קטנים ואישיים">
          <p>
            אני מאוד אוהב להגיע לבתי לקוחות וליצור חווית בשרים ייחודית ואינטימית. מה שאני אוהב
            באירוע בשרים בחצר הבית זה שיש לי זמן לדבר עם האנשים, להרגיש אותם, לספר להם על עצמי, על
            האוכל שהם הולכים לאכול, על סגנון הבישול שלי, על הנתחים ועל הירקות. אם אתם מתכננים ארוחה
            משפחתית ומחפשים שף בשרים לאירועים קטנים, אני הכתובת שלכם. מעבר לכך אני גם מציע חווית שף
            פרטית בבית שלכם לקבוצות קטנות ואינטימיות יותר.
          </p>
          <p>
            הרעיון שלי הוא לאפשר לכם להיות אורחים באירוע שלכם. אני דואג להכל מ0 ל100 ומוריד מכם כל
            דאגה וטרחה אפשרית. אני מביא איתי הכל: את הידע, את חומרי הגלם האיכותיים ביותר, צוות אדיב
            ומקצועי וכל הציוד הדרוש, כולל ציוד מושכר כמו צלחות, סכום, כוסות, שולחנות כסאות וכו.
            בנוסף אם תרצו אוכל לדאוג לשתייה קלה, חריפה וקרח. בין אם זו ארוחת בשרים ליום הולדת,
            קייטרינג לבר מצווה או קייטרינג למסיבות רווקות/רווקים אני דואג שהאירוח יהיה אישי, אדיב
            ומקצועי. לקריאה מורחבת על ארוחות פרטיות וקייטרינג לאירועים קטנים בחצר הבית או בשטח{' '}
            <a href="/catering/private-events" class={link}>
              לחצו כאן
            </a>
            . רוצים לקבל הצעת מחיר ופרטים נוספים ? תצלצלו אלי, שלחו ווצאפ או תשאירו{' '}
            <a href={quoteLink.href} class={link}>
              כאן
            </a>{' '}
            פרטים ואחזור אליכם בהקדם.
          </p>
        </ReadMore>
        <ReadMore variant="row" label="שולחן שוק ועמדות בשר">
          <p>
            זהו פתרון מושלם למי שרוצה אירוע באווירה משוחררת אך יוקרתית. אחד השירותים המבוקשים שלי
            הוא שולחן שוק בשרי כשר. אני יוצר שולחן בשרים מעוצב שהוא בעצם בופה בשרים עשיר, צבעוני
            ושופע, הכולל כל מיני סוגי נתחים, סלטים טריים, רטבים בעבודת יד ותוספות שמשלימות את
            החוויה. ללא מלצרים, מנות ראשונות והפקה גדולה. זה יכול להתאים לאנשים שמחפשים עמדת בשרים
            לאירועי חינה, שולחן שוק כשר לאירועי חברה ועוד.
            <br />
            הדרך שבה האוכל מוגש חשובה לא פחות מהטעם שלו. אני מקים דוכני מזון בשריים לאירועים ועמדות
            בשר שבהם האורחים רואים את הבשר נחתך ונצלה מול העיניים שלהם – זהו קרנבל בשרים שמפעיל את
            כל החושים.
            <br />
            לקריאה מורחבת על שולחנות שוק ועמדות בשר בחצר הבית או בשטח{' '}
            <a href="/catering/market-tables" class={link}>
              לחצו כאן
            </a>
            . רוצים לקבל הצעת מחיר ופרטים נוספים ? תצלצלו אלי, שלחו ווצאפ או תשאירו{' '}
            <a href={quoteLink.href} class={link}>
              כאן
            </a>{' '}
            פרטים ואחזור אליכם בהקדם.
          </p>
        </ReadMore>
      </div>
    </div>
  </Section>

  <Section heading="איך זה עובד" eyebrow="ארבעה שלבים">
    <StepList steps={steps} />
  </Section>

  <Section
    tone="dark"
    heading="חווית בשרים עם מסורת ארגנטינאית בשילוב עם מטבח ים-תיכוני גלילי"
    eyebrow="המומחיות שלי"
  >
    <div class={prose}>
      <p>
        אני גאה להביא לשוק קייטרינג דרום אמריקאי, כזה שנאמן למקורות אבל גם משלב בתוכו את הישראליות
        ואת הסיפור שלי, מטבח ים תיכוני, מטבח גלילי וחקלאות מקומית.
        <br />
        החיבור בין אש, טבע, אדמה, אוכל ומשפחה יוצר חוויות שבשבילם שווה לחיות ואני מאושר שהעבודה שלי
