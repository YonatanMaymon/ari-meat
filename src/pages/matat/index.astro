---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import Button from '../../components/ui/Button.astro';
import { quoteLink } from '../../data/nav';
import { getServices, groups, serviceHref } from '../../lib/services';
import { breadcrumbList } from '../../lib/schema';
import { getPage } from '../../lib/pages';

const page = await getPage('matatPage');
const services = await getServices('matat');
const crumbs = [{ label: 'בית', href: '/' }, { label: groups.matat.label }];
---

<BaseLayout
  title="חוויות במטעים במתת, בגליל"
  description="אירוח במטעים שלנו במושב מתת: ארוחות שף פרטיות, ימי גיבוש לצוותים, סדנאות וסיורים, מול נוף הגליל המערבי והים. בואו לבקר."
  image={page.heroImage}
  imageAlt={page.heroAlt}
  jsonLd={breadcrumbList(crumbs)}
>
  <Hero
    image={page.heroImage}
    imageAlt={page.heroAlt}
    title={page.heroTitle}
    subtitle={page.heroSubtitle}
    eyebrow={page.heroEyebrow || undefined}
    breadcrumbs={crumbs}
  >
    <Button href={quoteLink.href} size="lg">
      {quoteLink.label}
    </Button>
  </Hero>

  <Section heading={page.placeHeading} intro={page.placeIntro || undefined}>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {page.produce.map((item) => (
        <li class="rounded-card bg-sand p-5">
          <h3 class="text-xl font-bold">{item.title}</h3>
          <p class="mt-1">{item.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="sand" heading={page.servicesHeading}>
    <div class="grid gap-6 sm:grid-cols-2">
      {services.map((s) => (
        <ServiceCard
          title={s.data.label}
          description={s.data.summary}
          href={serviceHref(s)}
          image={s.data.image}
          imageAlt={s.data.imageAlt}
        />
      ))}
    </div>
  </Section>

  <CtaSection heading={page.ctaHeading} text={page.ctaText} />
</BaseLayout>
