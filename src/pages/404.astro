---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="הדף לא נמצא" description="הדף שחיפשתם לא קיים." noindex>
  <section class="container-content flex min-h-[60svh] flex-col items-center justify-center gap-6 py-16 text-center">
    <h1 class="text-4xl font-bold">הדף לא נמצא</h1>
    <p class="text-lg text-smoke-deep">ייתכן שהקישור ישן או שהדף עבר למקום אחר.</p>
    <Button href="/" icon="arrow">
      חזרה לדף הבית
    </Button>
  </section>
</BaseLayout>
