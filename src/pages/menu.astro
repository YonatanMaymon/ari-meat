---
// Menu. The prose is Ari's own, copied word for word from the old Wix page
// (content-migration/pages/menu.md), and edited by him in the admin (src/content/pages/menu.yaml).
// Nothing about dishes is added beyond what Ari wrote.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Markdown from '../components/Markdown.astro';
import CtaSection from '../components/CtaSection.astro';
import { getPage } from '../lib/pages';
import { breadcrumbList } from '../lib/schema';

const page = await getPage('menuPage');
const crumbs = [{ label: 'בית', href: '/' }, { label: 'תפריט' }];
---

<BaseLayout
  title="תפריט קייטרינג בשרי על האש"
  description="תפריט קייטרינג בשרי שנתפר לכל אירוע: אסאדו על הקרוס, פיקנייה מעושנת, אנטריקוט משויש, מנות צמחוניות וטבעוניות מהאש, פוקצ׳ות מהטאבון וסלטים גליליים."
  image={page.heroImage}
  imageAlt={page.heroAlt}
  jsonLd={breadcrumbList(crumbs)}
>
  <Hero
    image={page.heroImage}
    imageAlt={page.heroAlt}
    title={page.heroTitle}
    subtitle={page.heroSubtitle}
    breadcrumbs={crumbs}
  />

  {page.sections.map((section) => (
    <Section tone={section.tone} heading={section.heading || undefined}>
      <Markdown
        text={section.text}
        dark={section.tone === 'dark'}
        class="max-w-3xl text-lg leading-relaxed"
      />
    </Section>
  ))}

  <CtaSection heading={page.ctaHeading} text={page.ctaText} />
</BaseLayout>
