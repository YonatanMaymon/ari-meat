---
// Menu. The prose is Ari's own, copied word for word from the old Wix page
// (content-migration/pages/menu.md). Nothing about dishes is added beyond what Ari wrote.
import heroImage from '../assets/images/heroes/dips-and-flatbread.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import { quoteLink } from '../data/nav';
import { breadcrumbList } from '../lib/schema';

const crumbs = [{ label: 'בית', href: '/' }, { label: 'תפריט' }];

const link = 'font-semibold text-ember-deep underline underline-offset-4';
const prose = 'max-w-3xl space-y-5 text-lg leading-relaxed';
---

<BaseLayout
  title="תפריט קייטרינג בשרי על האש"
  description="תפריט קייטרינג בשרי שנתפר לכל אירוע: אסאדו על הקרוס, פיקנייה מעושנת, אנטריקוט משויש, מנות צמחוניות וטבעוניות מהאש, פוקצ׳ות מהטאבון וסלטים גליליים."
  image={heroImage}
  imageAlt="מגש של מטבלים, לחם שטוח ושום קונפי"
  jsonLd={breadcrumbList(crumbs)}
>
  <Hero
    image={heroImage}
    imageAlt="מגש של מטבלים, לחם שטוח ושום קונפי"
    title="החוויה הקולינרית של ארי"
    subtitle="תפריטים שנולדים מתוך חיבור של אדמה, בשר ואש"
    breadcrumbs={crumbs}
  />

  <Section>
    <div class={prose}>
      <p>
        כשאתם מזמינים את "ארי קייטרינג", אתם לא בוחרים מתוך קטלוג סגור. אני מאמין שאוכל טוב באמת הוא
        כזה שמתאים בדיוק לאופי של המארחים, לדינמיקה בין האורחים ולתנאי השטח של האירוע. לכן, כל אירוע
        שלי מתחיל בשיחה אישית. יחד, אנחנו בונים תפריט מותאם אישית – כזה שלוקח את חומרי הגלם הטובים
        ביותר של הגליל ומשלב אותם עם טכניקות צלייה ועישון מסורתיות, כדי לייצר חוויה קולינרית שהיא
        חד-פעמית עבורכם.
      </p>
    </div>
  </Section>

  <Section tone="sand" heading="הפילוסופיה: חומר גלם, אש וזמן">
    <div class={prose}>
      <p>
        הבסיס לכל מה שיוצא מהמעשנות והגרילים שלי הוא איכות ללא פשרות. אני עובד בשיטה של "מהחווה
        לשולחן", מה שאומר שכל ירק וכל נתח עוברים תחת הידיים שלי לפני שהם פוגשים את האש. בתפריט שנבנה
        עבורכם, נשלב את הטעמים העמוקים של דרום אמריקה עם הרעננות של מתת והגליל המערבי.
      </p>
      <p>אני מזמין אתכם לקבל הצצה קטנה אל חלק מהמנות שמהם נרכיב את התפריט שלכם:</p>
    </div>
  </Section>

  <Section heading="מנות פתיחה וראשונות: הניצוץ הראשון של האירוע">
    <div class={prose}>
      <p>
        החוויה מתחילה ברגע שהאורחים נכנסים ומתמלאים בריחות של בצק, ירקות חרוכים, בשר ושל עשן עדין.
        אנחנו יכולים לשלב בקבלת הפנים מנות מעוררות חושים כמו פוקצ'ות חמות שיוצאות מהטאבון ועליהן
        שום, עגבניות שרי מתפצפצות ופלפלים מעושנים, או סביצ'ה עונתי שמשלב דג טרי עם בצל סגול ורוטב
        סודי שנותן קיק של רעננות.
      </p>
      <p>
        לחובבי הבשר האותנטי, אני אוהב להציע פתיחה של אמפנדס פריכים במילויים שונים או צ'וריסוס
        ארגנטינאיות בתיבול מסורתי שמלוות בקינוח של צ'ימיצ'ורי ירוק ורענן. המטרה היא לייצר תנועה עם
        מנות כמו עראייס עסיסי שמוגש עם כל מיני סוגים של טחינה או סופלאקי יווני של עוף או פטריות על
        פיתה בעבודת יד שמחבר את האורחים לאווירה של חופש.
      </p>
    </div>
  </Section>

  <Section tone="dark" heading="הנתחים: אמנות האש והצלייה">
    <div class={prose}>
      <p>
        לב האירוע הוא תמיד הבשר, ושם אנחנו נתפור את התפריט למידותיכם. האם אתם מחפשים את הדרמה של
        אסאדו על הקרוס – נתח שנצלה שעות ארוכות מול אש גלויה ומתפרק מהעצם? או אולי אתם מעדיפים את
        הדיוק של אנטריקוט משויש שנצלה על גחלים עדינות ונפרס לעיני האורחים בשיא עסיסיותו?
      </p>
      <p>
        בתהליך בניית התפריט, נבחר את הנתחים שמתאימים לכם: מפיקנייה מעושנת שעברה טיפול של ימים ועד
        לנתחי ספיישל כמו טומהוק מרשים או שוק טלה במרינדת לימונית שנצלת לאיטה על הפריג'ה. כל נתח מקבל
        את זמן העישון והצלייה הדרוש לו, כדי להבטיח שבכל ביס תרגישו את העומק של הבשר ואת הארומה של
        עצי האלון והדובדבן שנאספים מהמטעים שלנו במתת.
      </p>
    </div>
  </Section>

  <Section heading="שפע מהאדמה: לא רק תוספות">
    <div class={prose}>
      <p>
        אני מאמין שירק שקיבל טיפול נכון על האש יכול להיות מרגש לא פחות מנתח פרימיום. לכן, התפריטים
        שלנו כוללים חוויה צמחונית וטבעונית עשירה שנעשית כולה באש חיה. תחשבו על סטייק חציל שמוגש על
        מצע טחינת הר ברכה עם עגבניות שרי מתפוצצות, רימונים ופיסטוקים, או פויקה צמחוני עשיר ביין אדום
        וירקות שורש שמתבשל שעות על הגחלים.
      </p>
      <p>
        הסלטים והתוספות שנבחר יחד הם אלו שמעניקים לארוחה את האיזון שלה. זה יכול להיות סלט קינואה עם
        סלק חרוך או סלט עלים עונתי ורענן זה יכול להיות תפוחי אדמה מדורה עם איולי עשבי טיבול או
        ברוקולי צלוי ואספרגוסים או שזה יכול להיות עוד מלא דברים אחרים. הכל טרי, צבעוני ומלא בטעם
        גלילי.
      </p>
    </div>
  </Section>

  <Section heading="תפירה אישית לכל קהל">
    <div class={prose}>
      <p>בסופו של דבר, האירוע הוא שלכם. כשניפגש או נדבר, נבין יחד:</p>
      <ul class="list-disc space-y-2 ps-6">
        <li>
          <strong>מי האורחים שלכם?</strong> האם מדובר בקהל של "פודיז" שמחפש נתחים מיוחדים, או אירוע
          משפחתי שדורש שפע ונגישות?
        </li>
        <li>
          <strong>מה האווירה?</strong> האם אתם מכוונים לשולחן שוק צבעוני ודינמי, או להגשה מוקפדת
          ואלגנטית לשולחנות?
        </li>
        <li>
          <strong>אילו העדפות מיוחדות יש לכם?</strong> אנחנו נתאים את מינון המנות הבשריות, הצמחוניות
          והטבעוניות כדי שכל אורח יצא שבע ומרוצה.
        </li>
      </ul>
      <p>
        אני כאן כדי לקחת את כל המרכיבים האלו ולהפוך אותם לחוויה אחת שלמה. התפריט הוא רק ההתחלה;
        הביצוע, השירות והנשמה שאנחנו מכניסים לאש הם אלו שעושים את ההבדל.
      </p>
      <p>
        רוצים לבנות ביחד את התפריט המושלם עבורכם ? צרו איתי קשר ונתחיל לבנות אותו ביחד. צלצלו, שלחו
        ווצאפ או פשוט תשאירו{' '}
        <a href={quoteLink.href} class={link}>
          כאן
        </a>{' '}
        פרטים ואחזור אליכם בהקדם.
      </p>
    </div>
  </Section>

  <CtaSection
    heading="בואו נבנה את התפריט שלכם"
    text="ספרו לנו על האירוע ועל האורחים, ונחזור עם הצעה לתפריט ומחיר."
  />
</BaseLayout>
