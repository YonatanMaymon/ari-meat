---
// The quote form, with the direct channels beside it. WhatsApp comes first: that's how most
// clients reach Ari.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../data/site';
import { breadcrumbList, business } from '../lib/schema';

const crumbs = [{ label: 'בית', href: '/' }, { label: 'יצירת קשר' }];

const channels = [
  {
    icon: 'whatsapp',
    title: 'וואטסאפ',
    text: 'הכי מהיר. כתבו לנו כמה פרטים על האירוע.',
    href: site.whatsapp.href,
    value: 'שליחת הודעה',
    external: true,
  },
  {
    icon: 'phone',
    title: 'טלפון',
    text: 'הכי טוב פשוט להתקשר.',
    href: site.phone.href,
    value: site.phone.display,
    ltr: true,
  },
  {
    icon: 'mail',
    title: 'אימייל',
    text: 'לשאלות, הצעות ומסמכים.',
    href: `mailto:${site.email}`,
    value: site.email,
    ltr: true,
  },
] as const;
---

<BaseLayout
  title="יצירת קשר והצעת מחיר"
  description={`קבלת הצעת מחיר לקייטרינג בשרי על האש: וואטסאפ, טלפון ${site.phone.display} או אימייל. ספרו לנו על האירוע ונחזור אליכם בהקדם.`}
  jsonLd={[breadcrumbList(crumbs), await business()]}
>
  <Hero
    title="קבלת הצעת מחיר"
    subtitle="ספרו לנו על האירוע ונחזור אליכם בהקדם עם רעיונות לתפריט והצעת מחיר."
    breadcrumbs={crumbs}
  />

  <Section>
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <QuoteForm />

      <aside aria-labelledby="channels-heading" class="lg:sticky lg:top-24">
        <h2 id="channels-heading" class="text-2xl font-bold">
          מעדיפים לדבר?
        </h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {channels.map((c) => (
            <li class="relative flex flex-col gap-2 rounded-card bg-white p-5 shadow-sm ring-1 ring-charcoal/5 transition-shadow hover:shadow-lg">
              <div class="flex items-center gap-3">
                <Icon name={c.icon} class="size-7 text-ember-deep" />
                <h3 class="text-xl font-bold">{c.title}</h3>
              </div>
              <p class="flex-1 text-smoke-deep">{c.text}</p>
              <a
                href={c.href}
                class="font-semibold break-all text-ember-deep after:absolute after:inset-0"
                {...('external' in c && { target: '_blank', rel: 'noopener' })}
              >
                <span dir={'ltr' in c ? 'ltr' : undefined}>{c.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </Section>

  <Section tone="sand" heading="איפה אנחנו">
    <address class="text-lg not-italic">
      <p class="font-semibold">{site.name}</p>
      <p>
        {site.address.street}, {site.address.locality}, {site.address.region}
      </p>
    </address>
    <p class="mt-4 max-w-2xl text-smoke-deep">
      לאירועים אנחנו מגיעים לכל הארץ. לארוחות שף וימי גיבוש במטעים, מגיעים אלינו למתת בתיאום מראש.
    </p>
  </Section>
</BaseLayout>
