---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/heroes/slicing-roast-beef.jpg';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';
import { galleryCategories } from '../data/gallery';
import { breadcrumbList } from '../lib/schema';

const crumbs = [{ label: 'בית', href: '/' }, { label: 'גלריה' }];

// Every file Keystatic stored. Formats Astro can optimise import as image metadata, others as a URL.
const files = import.meta.glob<{ default: ImageMetadata | string }>(
  '../assets/images/gallery/photos/*/*',
  { eager: true },
);
const photos = (await getCollection('gallery'))
  .sort((a, b) => Number(a.id) - Number(b.id))
  .flatMap(({ data }) => {
    // gallery.yaml and this page are both one folder below src/, so the paths match the glob keys.
    const file = files[data.image];
    if (!file) throw new Error(`Gallery photo ${data.image} not found (src/content/gallery.yaml)`);
    if (typeof file.default === 'string') {
      console.warn(`Gallery: skipping ${data.image}, not a JPG, PNG or WebP`);
      return [];
    }
    return [{ src: file.default, alt: data.alt.name, category: data.category }];
  });
---

<BaseLayout
  title="גלריה: אירועים וקייטרינג על האש"
  description="תמונות מאירועים, חתונות בטבע וארוחות שף של ארי קייטרינג: אש חיה, נתחים מהגריל ושולחנות ערוכים בכל הארץ ובמטעים במתת."
  image={heroImage}
  imageAlt="פריסת נתח בשר צלוי על קרש עץ"
  jsonLd={breadcrumbList(crumbs)}
>
  <Hero
    image={heroImage}
    imageAlt="פריסת נתח בשר צלוי על קרש עץ"
    title="גלריה"
    subtitle="רגעים מאירועים, מהאש ומהמטעים במתת."
    breadcrumbs={crumbs}
  />

  <Section>
    {photos.length > 0 ? (
      <ul class="columns-1 gap-4 sm:columns-2 lg:columns-3">
        {photos.map((photo) => (
          <li class="mb-4 break-inside-avoid">
            <figure>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[400, 800, 1200]}
                quality={70}
                sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                class="w-full rounded-card"
              />
              <figcaption class="sr-only">{galleryCategories[photo.category]}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    ) : (
      <div class="mx-auto max-w-xl py-10 text-center">
        <p class="text-lg">את התמונות האחרונות מהאירועים שלנו אפשר לראות באינסטגרם.</p>
        <div class="mt-6">
          <Button href={site.social.instagram} icon="instagram" target="_blank" rel="noopener">
            לאינסטגרם של ארי קייטרינג
          </Button>
        </div>
      </div>
    )}
  </Section>

  <CtaSection />
</BaseLayout>
