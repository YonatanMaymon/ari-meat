---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import CtaSection from '../../components/CtaSection.astro';
import Button from '../../components/ui/Button.astro';
import { quoteLink } from '../../data/nav';
import { getServices, groups, serviceHref } from '../../lib/services';
import { breadcrumbList } from '../../lib/schema';
import { getPage } from '../../lib/pages';

const page = await getPage('cateringPage');
const services = await getServices('catering');
const crumbs = [{ label: 'בית', href: '/' }, { label: groups.catering.label }];
---

<BaseLayout
  title="קייטרינג בשרי לאירועים בטבע ובכל הארץ"
  description="קייטרינג בשרי על האש לחתונות בטבע, אירועים פרטיים, אירועי חברה ושולחנות שוק. מטבח שטח עצמאי שמגיע לכל מקום בארץ. קבלו הצעת מחיר."
  image={page.heroImage}
  imageAlt={page.heroAlt}
  jsonLd={breadcrumbList(crumbs)}
>
  <Hero
    image={page.heroImage}
    imageAlt={page.heroAlt}
    title={page.heroTitle}
    subtitle={page.heroSubtitle}
    breadcrumbs={crumbs}
  >
    <Button href={quoteLink.href} size="lg">
      {quoteLink.label}
    </Button>
  </Hero>

  <Section heading={page.servicesHeading} intro={page.servicesIntro || undefined}>
    <div class="grid gap-6 sm:grid-cols-2">
      {services.map((s) => (
        <ServiceCard
          title={s.data.label}
          description={s.data.summary}
          href={serviceHref(s)}
          image={s.data.image}
          imageAlt={s.data.imageAlt}
        />
      ))}
    </div>
  </Section>

  <Section
    tone="sand"
    heading={page.areasHeading}
    eyebrow={page.areasEyebrow || undefined}
    intro={page.areasIntro || undefined}
  >
    <ServiceAreas />
  </Section>

  <CtaSection />
</BaseLayout>
