---
// About. The text is Ari's own, copied word for word from the old Wix page
// (content-migration/pages/about.md), and edited by him in the admin (src/content/pages/about.yaml).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Markdown from '../components/Markdown.astro';
import CtaSection from '../components/CtaSection.astro';
import { getPage } from '../lib/pages';
import { breadcrumbList } from '../lib/schema';

const page = await getPage('aboutPage');
const crumbs = [{ label: 'בית', href: '/' }, { label: 'אודות' }];
---

<BaseLayout
  title="אודות ארי, שף בשרים מהגליל"
  description="ארי הוא שף בשרים ממושב מתת שבגליל. חקלאות אורגנית, גרילים ומעשנות שבנה בעצמו, ומטבח ארגנטינאי וגלילי על אש חיה."
  image={page.heroImage}
  imageAlt={page.heroAlt}
  jsonLd={breadcrumbList(crumbs)}
>
  <Hero
    image={page.heroImage}
    imageAlt={page.heroAlt}
    title={page.heroTitle}
    subtitle={page.heroSubtitle}
    breadcrumbs={crumbs}
  />

  {page.sections.map((section) => (
    <Section tone={section.tone} heading={section.heading || undefined}>
      <Markdown
        text={section.text}
        dark={section.tone === 'dark'}
        class="max-w-3xl text-lg leading-relaxed"
      />
    </Section>
  ))}

  <CtaSection />
</BaseLayout>
