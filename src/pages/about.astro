---
// About. The text is Ari's own, copied word for word from the old Wix page
// (content-migration/pages/about.md); only the "לחצו כאן" links point to the new URLs.
import heroImage from '../assets/images/heroes/fire-pit-grill.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import { breadcrumbList } from '../lib/schema';

const crumbs = [{ label: 'בית', href: '/' }, { label: 'אודות' }];

const link = 'font-semibold text-ember-deep underline underline-offset-4';
const prose = 'max-w-3xl space-y-5 text-lg leading-relaxed';
---

<BaseLayout
  title="אודות ארי, שף בשרים מהגליל"
  description="ארי הוא שף בשרים ממושב מתת שבגליל. חקלאות אורגנית, גרילים ומעשנות שבנה בעצמו, ומטבח ארגנטינאי וגלילי על אש חיה."
  image={heroImage}
  imageAlt="גריל דרום אמריקאי מעל בור אש בגינה"
  jsonLd={breadcrumbList(crumbs)}
>
  <Hero
    image={heroImage}
    imageAlt="גריל דרום אמריקאי מעל בור אש בגינה"
    title="ארי - חווית בשר ייחודית"
    subtitle="הסיפור שמאחורי האש, הבשר והאדמה"
    breadcrumbs={crumbs}
  />

  <Section>
    <div class={prose}>
      <p>
        לכל אחד יש דרך למצוא את השקט שלו, אני מוצא את שלי מול גחלים לוחשות, בלב המטעים או במטבח. שמי
        ארי, והסיפור של "ארי קייטרינג" הוא לא סיפור על עסק למזון, אלא מסע של תשוקה ישנה לאדמה, לאש
        ולאנשים.
      </p>
      <p>
        הכל התחיל במושב מתת שבגליל המערבי. מקום שבו הטבע הוא לא רק תפאורה, אלא דרך חיים. שם, בין
        המטעים לבוסתנים, למדתי שאירוח אמיתי מתחיל בכבוד עמוק לחומר הגלם ובסבלנות שרק האש יכולה ללמד.
        כיום, כשאני מוביל קייטרינג בשרי לאירועים בכל רחבי הארץ, הערכים האלו הם המצפן שלי.
      </p>
    </div>
  </Section>

  <Section tone="sand" heading="מהחווה לשולחן: השורשים במתת">
    <div class={prose}>
      <p>
        הזהות הקולינרית שלי כשף בשרים נטועה עמוק באדמה. בבית שלי במתת, אני מיישם את עקרונות ה-"Farm
        to Table" (מהחווה לשולחן) במובן הכי שורשי שלהם: שמן זית מהעצים שלנו, ירקות שנקטפו בבוקר
        מהשדה שלי או של שכניי וכוס יין טובה בערב שאנחנו מייצרים מהגפנים שלנו.
      </p>
      <p>
        אני מאמין שבישול טוב דורש קשר ישיר עם מוצרי הגלם והבנה של העונות. בין אם מדובר בקייטרינג
        ליום הולדת, קייטרינג לבר מצווה או קייטרינג לחתונה בטבע, אני מביא איתי את הניחוח הגלילי
        והמסורת הארגנטינאית. הבשר נבחר בפינצטה לפי רמת היישון והשיוש שלו, וכל מנה עוברת תחת הידיים
        שלי לפני שהיא פוגשת את האש.
      </p>
    </div>
  </Section>

  <Section heading="אומנות הברזל: כשהשף בונה את המטבח שלו">
    <div class={prose}>
      <p>
        מה שמייחד אותנו הוא לא רק מה שאנחנו מבשלים, אלא איך אנחנו מבשלים. אני לא משתמש בציוד תעשייתי
        סטנדרטי. מתוך תשוקה לדיוק מוחלט, תכננתי ובניתי במו ידי את המעשנות והגרילים של "ארי
        קייטרינג".
      </p>
      <p>
        המעשנות שלי נבנו במיוחד עבורי ואני עובד עם זני עץ ספציפיים כמו אלון, דובדבן ושקד המעניקים
        לבשר ארומה עמוקה שאי אפשר לחקות. בניית הציוד בעצמי מעניקה לי שליטה מוחלטת בטמפרטורה ובזרימת
        העשן – מה שמבטיח שכל נתח שיוצא תחת ידי יהיה בסטנדרט של קייטרינג בשרי איכותי יוקרתי.
      </p>
    </div>
  </Section>

  <Section tone="sand" heading="השטח הוא המגרש הביתי שלנו">
    <div class={prose}>
      <p>
        'איך אפשר להוציא ארוחת שף בלב המדבר או ביער מבודד?'. התשובה היא ניסיון לוגיסטי של שנים. ארי
        קייטרינג מגיע לכל נקודה בארץ עם עצמאות מלאה – ממטבחי חוץ וגרילים בבנייה אישית, דרך מערכות
        קירור מתקדמות לשמירה על טריות הבשר, ועד גנרטורים שקטים ותאורה. אנחנו לא צריכים תשתיות, אנחנו
        מביאים אותן איתנו. אתם בוחרים את הלוקיישן הכי פרוע שחלמתם עליו – אנחנו דואגים שרמת האוכל
        והשירות תהיה של מסעדת עילית, גם בקצה העולם.
      </p>
      <p>
        אנחנו מגיעים אליכם לכל מקום: כבר ערכנו אירועים בצפון הרחוק, ברמת הגולן והכנרת, בגליל, עמק
        יזרעאל, חיפה והכרמל, דרך אזור השרון, גוש דן ותל אביב, ועד הרי ירושלים, ים המלח, מדבר יהודה
        והנגב.
      </p>
    </div>
  </Section>

  <Section heading="אירוח בגובה העיניים">
    <div class={prose}>
      <p>
        למרות הסטנדרט המקצועי הגבוה, האירוח שלנו תמיד נשאר בגובה העיניים. השירות הוא חלק בלתי נפרד
        מהטעם. בין אם מדובר בקייטרינג לאירועים קטנים בבית הלקוח ובין אם בקייטרינג לאירועי חברה
        גדולים, הצוות שלי ואני מגיעים כדי לשמח. אנחנו דואגים לניקיון מופתי, לסדר לוגיסטי ולתשומת לב
        לכל פרט, כדי שאתם תוכלו להיות אורחים באירוע שלכם.
      </p>
    </div>
  </Section>

  <Section tone="sand" heading="הבית במתת: סדנאות וריטריטים">
    <div class={prose}>
      <p>
        הלב שלי נשאר בגליל. הבית והמטעים במתת הם המקום שבו אני מארח סדנאות בשרים חווייתיות ויום
        גיבוש למנהלים ולצוותי פיתוח. שם, מול הנוף הפנורמי, אנו מקיימים ריטריט ו- offsite קולינרי
        המשלב חיבור לאדמה וזמן איכות לקבוצות מול האש והחורש. כמו כן, אנחנו גם עורכים במטעים שלנו גם
        אירועים קטנים ופשוטים יותר למשפחות או קבוצות חברים.
      </p>
      <p>
        אני מזמין אתכם להצטרף אלינו לחגיגה של אש, בשר ואדמה. בואו נהפוך את האירוע שלכם לזיכרון גלילי
        שורשי ובלתי נשכח. לפרטים נוספים עבור ימי הגיבוש{' '}
        <a href="/matat/team-building" class={link}>
          לחצו כאן
        </a>{' '}
        ועבור ארוחות פרטיות בבית שלי במתת{' '}
        <a href="/matat/private-chef" class={link}>
          לחצו כאן
        </a>
        .
      </p>
    </div>
  </Section>

  <CtaSection />
</BaseLayout>
