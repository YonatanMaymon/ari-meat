---
import heroImage from '../assets/images/heroes/fire-pit-grill.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import { breadcrumbList } from '../lib/schema';

const crumbs = [{ label: 'בית', href: '/' }, { label: 'אודות' }];

const values = [
  {
    title: 'מהחווה לשולחן',
    text: 'שמן זית מהעצים שלנו, ירקות שנקטפו בבוקר ויין מהגפנים שלנו. בישול טוב מתחיל בקשר ישיר לחומר הגלם ולעונות.',
  },
  {
    title: 'גרילים שבנינו בעצמנו',
    text: 'ארי תכנן ובנה את המעשנות והגרילים. זה נותן שליטה מלאה בחום ובעשן, עם עצי אלון, דובדבן ושקד.',
  },
  {
    title: 'השטח הוא הבית',
    text: 'מטבחי חוץ, קירור, גנרטורים ותאורה. אנחנו לא צריכים תשתיות, אנחנו מביאים אותן איתנו.',
  },
  {
    title: 'אירוח בגובה העיניים',
    text: 'רמה של מסעדת שף, עם חיוך, ניקיון ותשומת לב לכל פרט, כדי שאתם תהיו אורחים באירוע שלכם.',
  },
];
---

<BaseLayout
  title="אודות ארי, שף בשרים מהגליל"
  description="ארי הוא שף בשרים ממושב מתת שבגליל. חקלאות אורגנית, גרילים ומעשנות שבנה בעצמו, ומטבח ארגנטינאי וגלילי על אש חיה."
  jsonLd={breadcrumbList(crumbs)}
>
  <Hero
    image={heroImage}
    imageAlt="גריל דרום אמריקאי מעל בור אש בגינה"
    title="ארי: אש, בשר ואדמה"
    subtitle="הסיפור של ארי קייטרינג הוא לא סיפור של עסק לאוכל. זו תשוקה ישנה לאדמה, לאש ולאנשים."
    breadcrumbs={crumbs}
  />

  <Section heading="הכול התחיל במתת" eyebrow="הסיפור">
    <div class="max-w-3xl space-y-5 text-lg leading-relaxed">
      <p>
        לכל אחד יש מקום שבו הוא מוצא שקט. ארי מוצא את שלו מול גחלים לוחשות, בלב המטעים או במטבח.
      </p>
      <p>
        הכול התחיל במושב מתת, שבו הטבע הוא דרך חיים ולא תפאורה. שם, בין המטעים לבוסתנים, ארי למד
        שאירוח אמיתי מתחיל בכבוד לחומר הגלם ובסבלנות שרק האש מלמדת. היום, כשהוא מבשל באירועים בכל
        רחבי הארץ, אלה הערכים שמובילים אותו.
      </p>
      <p>
        מתת נמצאת 700 מטרים מהגבול. מאז ה-7 באוקטובר עברו על המושב שנים לא פשוטות, והמשפחה נשארה כדי
        לשמור על מה ששלה. על כל קטיושה שפגעה, הם שתלו עץ חדש.
      </p>
    </div>
  </Section>

  <Section tone="sand" heading="מה מייחד אותנו">
    <ul class="grid gap-6 sm:grid-cols-2">
      {values.map((v) => (
        <li class="rounded-card bg-cream p-7">
          <h3 class="text-2xl font-bold">{v.title}</h3>
          <p class="mt-3 text-lg">{v.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section heading="הבית במתת">
    <div class="max-w-3xl space-y-5 text-lg leading-relaxed">
      <p>
        הלב נשאר בגליל. במטעים ובבית במתת ארי מארח סדנאות בשרים, ימי גיבוש לצוותים וארוחות פרטיות
        למשפחות ולחברים, מול נוף הגליל המערבי והים.
      </p>
    </div>
    <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-semibold">
      <li>
        <a href="/matat/private-chef" class="text-ember-deep underline underline-offset-4">
          ארוחות שף פרטיות במתת
        </a>
      </li>
      <li>
        <a href="/matat/team-building" class="text-ember-deep underline underline-offset-4">
          ימי גיבוש במטעים
        </a>
      </li>
      <li>
        <a href="/catering" class="text-ember-deep underline underline-offset-4">
          קייטרינג לאירועים בכל הארץ
        </a>
      </li>
    </ul>
  </Section>

  <CtaSection />
</BaseLayout>
