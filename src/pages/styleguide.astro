---
// Internal component preview for design review (noindex, kept out of the sitemap).
// Delete before launch, see plan.md Phase 6.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Button from '../components/ui/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import Testimonial from '../components/Testimonial.astro';
import { site } from '../data/site';

const colors = [
  ['charcoal', 'bg-charcoal'],
  ['charcoal-soft', 'bg-charcoal-soft'],
  ['brass', 'bg-brass'],
  ['brass-deep', 'bg-brass-deep'],
  ['brass-light', 'bg-brass-light'],
  ['olive', 'bg-olive'],
  ['cream', 'bg-cream'],
  ['sand', 'bg-sand'],
  ['smoke', 'bg-smoke'],
  ['muted', 'bg-muted'],
] as const;
---

<BaseLayout title="מדריך עיצוב" description="תצוגה פנימית של רכיבי העיצוב של האתר." noindex>
  <Hero
    title="אש, אדמה והגליל"
    subtitle="דוגמה של ה-Hero ללא תמונה. עם תמונה מקורית מארי, היא תופיע כרקע מלא."
    size="full"
  >
    <Button href="/contact" size="lg">
      קבלת הצעת מחיר
    </Button>
    <Button href={site.whatsapp.href} variant="whatsapp" size="lg" icon="whatsapp">
      וואטסאפ
    </Button>
  </Hero>

  <Section
    id="tokens"
    heading="צבעים וטיפוגרפיה"
    eyebrow="טוקנים"
    intro="פלטת הצבעים מ-plan.md עם גוונים נוספים לעמידה בניגודיות."
  >
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-5">
      {colors.map(([name, bg]) => (
        <li>
          <div class:list={['h-16 rounded-card ring-1 ring-charcoal/10', bg]} />
          <span class="mt-1 block text-sm" dir="ltr">
            {name}
          </span>
        </li>
      ))}
    </ul>
    <p class="mt-10 font-display text-5xl font-bold">פרנק רוהל ליברה לכותרות</p>
    <p class="mt-3 text-lg">היבו לטקסט רץ: בשרים על האש, מטבח ארגנטינאי וגלילי, בכל הארץ.</p>
    <p class="mt-6">
      <a href="/styleguide/hero" class="font-semibold text-brass-deep underline">
        שני כיווני העיצוב לראש עמוד הבית
      </a>
    </p>
  </Section>

  <Section id="buttons" tone="sand" heading="כפתורים">
    <div class="flex flex-wrap gap-3">
      <Button>ראשי</Button>
      <Button variant="secondary">משני</Button>
      <Button variant="whatsapp" icon="whatsapp">
        וואטסאפ
      </Button>
      <Button href="/catering" icon="arrow">
        עם חץ
      </Button>
    </div>
  </Section>

  <Section
    id="services"
    heading="שירותים"
    eyebrow="קייטרינג לאירועים"
    intro="כרטיסי שירות, ללא תמונה עד שיגיעו התמונות המקוריות."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <ServiceCard
        title="חתונות בטבע"
        description="חתונה בשטח פתוח עם בשרים על האש, עמדות ולוגיסטיקה מלאה."
        href="/catering/weddings"
      />
      <ServiceCard
        title="אירועי חברה"
        description="ימי כיף, כנסים ואירועי צוות עם שף ועמדות בשר חיות."
        href="/catering/corporate-events"
      />
      <ServiceCard
        title="ארוחת שף פרטית במתת"
        description="ערב בוטיק בין עצי הזית, עם תפריט שנבנה במיוחד בשבילכם."
        href="/matat/private-chef"
      />
    </div>
  </Section>

  <Section
    id="testimonials"
    tone="dark"
    heading="מה אומרים עלינו"
    eyebrow="המלצות"
    intro="טקסט לדוגמה בלבד. המלצות אמיתיות יגיעו מארי."
  >
    <div class="grid gap-6 md:grid-cols-2">
      <Testimonial
        quote="טקסט המלצה לדוגמה. הבשר היה מדויק, הצוות הגיע מוקדם ודאג לכל פרט."
        name="שם לדוגמה"
        event="חתונה בטבע, עמק יזרעאל"
      />
      <Testimonial quote="טקסט המלצה לדוגמה נוסף, קצר יותר." name="שם לדוגמה" />
    </div>
  </Section>

  <Section id="faq" heading="שאלות נפוצות">
    <div class="max-w-3xl">
      <FaqList
        items={[
          {
            question: 'מה מספר האורחים המינימלי?',
            answer: 'תשובה לדוגמה: אנחנו עושים אירועים החל מ-15 איש.',
          },
          {
            question: 'כמה זמן מראש צריך להזמין?',
            answer: 'תשובה לדוגמה, תתעדכן בשלב כתיבת התוכן.',
          },
        ]}
      />
    </div>
  </Section>
</BaseLayout>
