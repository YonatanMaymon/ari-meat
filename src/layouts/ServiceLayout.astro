---
// Shared layout for the six service pages (plan.md section 3, "Service page"):
// hero → Ari's text from the old site → how it works → FAQs → related → CTA.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import FaqList from '../components/FaqList.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaSection from '../components/CtaSection.astro';
import Button from '../components/ui/Button.astro';
import Markdown from '../components/Markdown.astro';
import { site } from '../data/site';
import { quoteLink } from '../data/nav';
import { groups, getServices, serviceHref, type Service } from '../lib/services';
import { breadcrumbList, faqPage, service as serviceSchema } from '../lib/schema';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
const { data } = service;
const href = serviceHref(service);
const group = groups[data.group];
// Opens the quote form with this service's event type already selected.
const quoteHref = `${quoteLink.href}?service=${service.id}#quote-form`;

const crumbs = [{ label: 'בית', href: '/' }, group, { label: data.label }];
const all = await getServices();
const related = data.related
  .map((id) => all.find((s) => s.id === id))
  .filter((s): s is Service => Boolean(s));

// Section photos Ari added in the admin. Formats Astro can optimise import as image metadata,
// others as a URL and are skipped (as on the gallery page).
const files = import.meta.glob<{ default: ImageMetadata | string }>(
  '../assets/images/services/*/sections/*/*',
  { eager: true },
);
const sections = data.sections.map(({ heading, text, image, imageAlt }) => {
  // The YAML path is relative to src/content/services/, the glob keys to this folder.
  const file = image ? files[image.replace(/^\.\.\/\.\.\//, '../')] : undefined;
  if (image && !file) throw new Error(`Service photo ${image} not found (${service.id}.yaml)`);
  if (typeof file?.default === 'string') {
    console.warn(`${service.id}: skipping ${image}, not a JPG, PNG or WebP`);
  }
  const photo = typeof file?.default === 'object' ? file.default : undefined;
  return { heading: heading.name, text, photo, alt: imageAlt || heading.name || data.title };
});
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  image={data.image}
  imageAlt={data.imageAlt}
  jsonLd={[
    breadcrumbList(crumbs),
    await serviceSchema(data.title, data.description, href),
    faqPage(data.faqs),
  ]}
>
  <Hero
    title={data.title}
    subtitle={data.subtitle}
    breadcrumbs={crumbs}
    image={data.image}
    imageAlt={data.imageAlt}
  >
    <Button href={quoteHref} size="lg">
      {quoteLink.label}
    </Button>
    <Button href={site.whatsapp.href} variant="whatsapp" size="lg" icon="whatsapp">
      וואטסאפ
    </Button>
  </Hero>

  <Section>
    <div class="space-y-12 text-lg leading-relaxed">
      {sections.map(({ heading, text, photo, alt }) => (
        // The text keeps its reading width either way. A photo fills the space to its left on wide
        // screens (RTL) and goes under the text where that space is too narrow.
        <div class:list={photo && 'grid items-start gap-8 xl:grid-cols-[48rem_1fr] xl:gap-12'}>
          <div class="max-w-3xl space-y-5">
            {heading && <h2 class="text-3xl font-bold">{heading}</h2>}
            <Markdown text={text} />
          </div>
          {photo && (
            <Image
              src={photo}
              alt={alt}
              widths={[400, 800, 1200]}
              quality={70}
              sizes="(min-width: 80rem) 20rem, (min-width: 48rem) 48rem, 100vw"
              class="w-full max-w-3xl rounded-card object-cover shadow-sm"
            />
          )}
        </div>
      ))}
    </div>
  </Section>

  <Section heading="איך זה עובד" eyebrow="שלב אחר שלב">
    <StepList steps={data.steps} />
  </Section>

  <Section tone="sand" heading="שאלות נפוצות" eyebrow="לפני שמתקשרים">
    <div class="max-w-3xl">
      <FaqList items={data.faqs} />
    </div>
  </Section>

  {related.length > 0 && (
    <Section heading="אולי יעניין אתכם גם">
      <div class="grid gap-6 sm:grid-cols-2">
        {related.map((s) => (
          <ServiceCard
            title={s.data.label}
            description={s.data.summary}
            href={serviceHref(s)}
            image={s.data.image}
            imageAlt={s.data.imageAlt}
          />
        ))}
      </div>
    </Section>
  )}

  <CtaSection quoteHref={quoteHref} />
</BaseLayout>
