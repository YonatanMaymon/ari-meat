---
import '../styles/global.css';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';

export type Props = SeoProps;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1c1a17" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...Astro.props} />
  </head>
  <body class="bg-cream text-charcoal antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded focus:bg-charcoal focus:px-4 focus:py-2 focus:text-cream"
    >
      דלג לתוכן
    </a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
