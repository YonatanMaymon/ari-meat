---
import '../styles/global.css';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import { webAnalyticsToken } from '../lib/config';
import FontFaces from '../components/FontFaces.astro';

export type Props = SeoProps;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1c1a17" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <FontFaces />
    <Seo {...Astro.props} />
    <slot name="head" />
  </head>
  <!-- Bottom padding on phones keeps the fixed MobileCtaBar from covering the footer. -->
  <body class="flex min-h-svh flex-col bg-cream pb-16 font-sans text-charcoal antialiased md:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded focus:bg-charcoal focus:px-4 focus:py-2 focus:text-cream"
    >
      דלג לתוכן
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCtaBar />
    {
      // Cookie-less page views (no consent banner needed). Off until the token is set in config.ts.
      webAnalyticsToken && !import.meta.env.DEV && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: webAnalyticsToken })}
        />
      )
    }
    <script>
      import { trackContactLinks } from '../lib/track';
      trackContactLinks();
    </script>
  </body>
</html>
