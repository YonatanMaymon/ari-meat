{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ari-catering",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serves catering/weddings.html at /catering/weddings and redirects the .html and slash variants to it.
    "html_handling": "auto-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
  // Workers Builds uploads each non-master branch as a version; this serves it at
  // <version>-ari-catering.ari-catering.workers.dev. Canonicals point to www.aricatering.com.
  "workers_dev": true,
  "preview_urls": true,

  // Phase 4 (quote form) will add:
  //   - "send_email": [{ "name": "QUOTE_EMAIL", "destination_address": "<verified inbox>" }]
  //   - TURNSTILE_SECRET_KEY via `wrangler secret put` (locally in .dev.vars, never committed)
  // Phase 6 (launch) will add "routes" for www.aricatering.com once DNS is on Cloudflare.
}
