{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ari-catering",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serves catering/weddings.html at /catering/weddings and redirects the .html and slash variants to it.
    "html_handling": "auto-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
  // Workers Builds uploads each non-master branch as a version; this serves it at
  // <version>-ari-catering.ari-catering.workers.dev. Canonicals point to www.aricatering.com.
  "workers_dev": true,
  "preview_urls": true,

  // Quote requests and contact-click events (src/lib/db.ts). No database_id: `wrangler deploy`
  // creates the database on first deploy and finds it by name after that.
  "d1_databases": [{ "binding": "DB" }],

  // Quote emails to Ari (src/pages/api/quote.ts). Restricted to his inbox. Sending only works once
  // aricatering.com is on Cloudflare with Email Routing on and this address verified (Phase 6).
  "send_email": [{ "name": "QUOTE_EMAIL", "destination_address": "arielmaykab@gmail.com" }],

  // Secrets (not in this file):
  //   TURNSTILE_SECRET_KEY: dashboard → Workers → ari-catering → Settings → Variables and Secrets.
  //   Locally in .dev.vars (copy .dev.vars.example).
  // Phase 6 (launch) will add "routes" for www.aricatering.com once DNS is on Cloudflare.
}
